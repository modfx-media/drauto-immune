# Payload admin + API secret. Generate a long random string. Required for /admin.
PAYLOAD_SECRET=

# Neon Postgres pooled connection string (host contains -pooler, typically port 5432
# via the pooler / WebSockets). Prefer pooled over direct — direct DATABASE_URL_UNPOOLED
# on port 5432 often times out from Vercel / many networks.
DATABASE_URL=

# Optional direct (unpooled) Neon URL for migrations/tools that need it.
DATABASE_URL_UNPOOLED=

# Shared secret for /next/preview. Required for admin live preview URLs.
PREVIEW_SECRET=

# Public site origin (https). Used for metadata, sitemap, and CORS fallbacks.
NEXT_PUBLIC_SITE_URL=https://drautoimmune.com

# Payload serverURL / preview origin.
# Local: http://localhost:3000
# Vercel Production / Preview: the public https origin (never localhost).
NEXT_PUBLIC_SERVER_URL=https://drautoimmune.com

# Optional. Without this, Payload stores media under /media (404s on Vercel).
BLOB_READ_WRITE_TOKEN=
