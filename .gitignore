# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local Payload uploads (Vercel Blob in production)
/media

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# content migration debug cache (raw HTML/MD snapshots, not part of the app)
/content/cache/
images/home-bg-video.mp4
